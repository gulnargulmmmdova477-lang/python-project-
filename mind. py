import asyncio
from aiogram import Bot, Dispatcher, types, F
from aiogram.filters import CommandStart
from aiogram.utils.keyboard import InlineKeyboardBuilder


BOT_TOKEN = ""

bot = Bot(token=BOT_TOKEN)
dp = Dispatcher()


@dp.message(CommandStart())
async def cmd_start(message: types.Message):
    builder = InlineKeyboardBuilder()
    builder.button(text="Math", callback_data="Math1")
    builder.button(text="Help", callback_data="Help1")
    builder.adjust(2)  # Two buttons in 1 row

    await message.answer(
        "Choose",
        reply_markup=builder.as_markup()
    )

@dp.callback_query(F.data == "Math1")
async def process_left_1(callback: types.CallbackQuery):
    builder = InlineKeyboardBuilder()
    builder.button(text="9-th grade", callback_data="step_left_2")
    builder.button(text="11-th grade", callback_data="step_right_2")
    builder.button(text="🔙 Back", callback_data="back_to_start")
    builder.adjust(2, 1) 


    await callback.message.edit_text(
        "You choosed **MATH**.\n\n",
        parse_mode="Markdown",
        reply_markup=builder.as_markup()
    )
    await callback.answer()  


@dp.callback_query(F.data == "Help1")
async def process_right_1(callback: types.CallbackQuery):
    builder = InlineKeyboardBuilder()
    builder.button(text="Option А", callback_data="option_a")
    builder.button(text="Option B", callback_data="option_b")
    builder.button(text="🔙 Back", callback_data="back_to_start")
    builder.adjust(2, 1)

    await callback.message.edit_text(
        "You choosed **HELP**.\n\n This bot was created for practing DIM exam",
        parse_mode="Markdown",
        reply_markup=builder.as_markup()
    )
    await callback.answer()

# 4.Return Back button
@dp.callback_query(F.data == "back_to_start")
async def back_to_start(callback: types.CallbackQuery):
    builder = InlineKeyboardBuilder()
    builder.button(text="Math", callback_data="Math1")
    builder.button(text="Help", callback_data="Help1")
    builder.adjust(2)

    await callback.message.edit_text(
        "Choose.",
        reply_markup=builder.as_markup()
    )
    await callback.answer()

async def main():
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())